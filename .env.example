# Universal Log Pre-processing Framework (ULPF)
# Environment Configuration Template

# System Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Universal Log Pre-processing Framework"
VERSION="1.0.0"

# CORS Configuration (comma-separated or wildcard for local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL) - Default placeholders for Docker Compose
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=ulpf_db
POSTGRES_USER=ulpf_admin
POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://ulpf_admin:replace_with_secure_password@db:5432/ulpf_db

# Local development override (when running outside Docker):
# DATABASE_URL=postgresql://ulpf_admin:replace_with_secure_password@localhost:5432/ulpf_db

# Air-Gapped & Storage Configuration
AIR_GAPPED_MODE=True
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
SYNTHETIC_DATA_PATH=./data/synthetic

# Live Syslog Ingestion Engine Configuration
SYSLOG_ENABLED=False
SYSLOG_ALLOW_API_CONTROL=True

# UDP Syslog Listener (dev default: 1514, prod: 514)
SYSLOG_UDP_ENABLED=True
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=1514

# TCP Syslog Listener (dev default: 1514, prod: 514)
SYSLOG_TCP_ENABLED=True
SYSLOG_TCP_HOST=0.0.0.0
SYSLOG_TCP_PORT=1514

# TLS Syslog Listener (dev default: 16514, prod: 6514)
SYSLOG_TLS_ENABLED=False
SYSLOG_TLS_HOST=0.0.0.0
SYSLOG_TLS_PORT=16514

# Limits & Queue Backpressure
SYSLOG_MAX_MESSAGE_BYTES=65536
SYSLOG_QUEUE_MAXSIZE=10000
SYSLOG_WORKERS=4
SYSLOG_TCP_IDLE_TIMEOUT_SECONDS=60
SYSLOG_TCP_CONNECTION_LIMIT=100

# TLS Certificate Paths (required if SYSLOG_TLS_ENABLED=True)
# SYSLOG_TLS_CERTFILE=./certs/server.crt
# SYSLOG_TLS_KEYFILE=./certs/server.key
# SYSLOG_TLS_CAFILE=./certs/ca.crt

# Phase 4B: Parquet Columnar Export
ULPF_PARQUET_EXPORT_DIR=./data/processed
ULPF_EXPORT_BATCH_SIZE=10000

# Phase 4B: Offline Anomaly Detection Baseline
ULPF_ANOMALY_CONTAMINATION=0.01
ULPF_ANOMALY_RANDOM_STATE=42
ULPF_ANOMALY_MIN_TRAIN_RECORDS=20

